+template <class FusionParams>
+struct bsvd_side_finder {
+  static constexpr int index = 1;   // resolved by SFINAE at the call sites
+  CUTLASS_HOST_DEVICE static int num_side(FusionParams const& p) { return bsvd_num_side_impl(p, 0); }
+  CUTLASS_DEVICE static void run(FusionParams const& p, char* smem, int side_idx) { bsvd_side_run_impl(p, smem, side_idx, 0); }
+  CUTLASS_DEVICE static void tile_pre(FusionParams const& p, char* smem, int t, int nt) { bsvd_tile_pre_impl(p, smem, t, nt, 0); }
+  template <class FS>
+  CUTLASS_DEVICE static void tile_entry(FusionParams const& p, FS* fs, int t) { bsvd_tile_entry_impl(p, fs, t, 0); }
+  template <class FS>
+  CUTLASS_DEVICE static void tile_helper(FusionParams const& p, FS* fs, int tn, int hw) { bsvd_tile_helper_impl(p, fs, tn, hw, 0); }
+  CUTLASS_HOST_DEVICE static int cl_S(FusionParams const& p) { return bsvd_cl_S_impl(p, 0); }
+  CUTLASS_HOST_DEVICE static int cl_T(FusionParams const& p) { return bsvd_cl_T_impl(p, 0); }
+  CUTLASS_HOST_DEVICE static int cl_C(FusionParams const& p) { return bsvd_cl_C_impl(p, 0); }
+  CUTLASS_HOST_DEVICE static int cl_grid(FusionParams const& p) { return bsvd_cl_grid_impl(p, 0); }
+  CUTLASS_HOST_DEVICE static int cl_F(FusionParams const& p) { return bsvd_cl_F_impl(p, 0); }
+  template <class FS>
+  CUTLASS_DEVICE static void cl_side(FusionParams const& p, char* smem, FS* fs, int c, int r) { bsvd_cl_side_impl(p, smem, fs, c, r, 0); }
+  template <class FS>
+  CUTLASS_DEVICE static void cl_tile(FusionParams const& p, FS* fs) { bsvd_cl_tile_impl(p, fs, 0); }
+  template <class Sch>
+  CUTLASS_DEVICE static void sched_set(Sch& s, uint64_t idx, uint64_t total) { bsvd_sched_set_impl(s, idx, total, 0); }
+};
+} // namespace cutlass::gemm::kernel::detail
