+  cute::remove_cvref_t<decltype(p.op_1)>::side_cluster(p.op_1, smem, reinterpret_cast<void*>(&cute::get<1>(*fs)), c, r);
+}
+template <class FP, class FS>
+CUTLASS_DEVICE void bsvd_cl_side_impl(FP const&, char*, FS*, int, int, long) {}
+template <class FP, class FS>
+CUTLASS_DEVICE auto bsvd_cl_tile_impl(FP const& p, FS* fs, int)
+    -> decltype(p.op_1.cl_S, void()) {
+  cute::remove_cvref_t<decltype(p.op_1)>::tile_prologue(p.op_1, reinterpret_cast<void*>(&cute::get<1>(*fs)));
