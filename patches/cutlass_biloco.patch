+#pragma once
+// BiLoCo side-CTA hook: the kernel launches one extra grid
+// layer of CTAs beyond the tile grid; those CTAs run a fusion-op-provided side
+// function (binary low-rank z computation) and exit before any pipeline init.
+// Detection is by expression SFINAE on the fusion params: the zU fusion op is
+// child 1 of the EVT (member `op_1` of the 2..4-op visitor Params structs, or
+// tuple element 1), and exposes `num_side` and a static `side_cta`.
+#include "cute/container/tuple.hpp"
+namespace cutlass::gemm::kernel::detail {
+template <class FP>
+CUTLASS_HOST_DEVICE auto bsvd_elem1(FP const& p, int) -> decltype((p.op_1)) { return p.op_1; }
+template <class FP>
+CUTLASS_HOST_DEVICE auto bsvd_elem1(FP const& p, long) -> decltype(cute::get<1>(p)) { return cute::get<1>(p); }
+
+template <class FP>
+CUTLASS_HOST_DEVICE auto bsvd_num_side_impl(FP const& p, int) -> decltype(int(bsvd_elem1(p, 0).num_side)) { return bsvd_elem1(p, 0).num_side; }
+template <class FP>
+CUTLASS_HOST_DEVICE int bsvd_num_side_impl(FP const&, long) { return 0; }
+
+template <class FP>
+CUTLASS_DEVICE auto bsvd_side_run_impl(FP const& p, char* smem, int idx, int)
+    -> decltype(cute::remove_cvref_t<decltype(bsvd_elem1(p, 0))>::side_cta(bsvd_elem1(p, 0), smem, idx), void()) {
+  cute::remove_cvref_t<decltype(bsvd_elem1(p, 0))>::side_cta(bsvd_elem1(p, 0), smem, idx);
+}
+template <class FP>
+CUTLASS_DEVICE void bsvd_side_run_impl(FP const&, char*, int, long) {}
+
+// tile CTAs: optional pre-GEMM work (fusion op exposes a static tile_pre(op, smem, tile_idx, n_tiles)),
+// run at kernel entry while the whole shared memory is still free
+template <class FP>
+CUTLASS_DEVICE auto bsvd_tile_pre_impl(FP const& p, char* smem, int t, int nt, int)
+    -> decltype(cute::remove_cvref_t<decltype(bsvd_elem1(p, 0))>::tile_pre(bsvd_elem1(p, 0), smem, t, nt), void()) {
+  cute::remove_cvref_t<decltype(bsvd_elem1(p, 0))>::tile_pre(bsvd_elem1(p, 0), smem, t, nt);
+}
+template <class FP>
+CUTLASS_DEVICE void bsvd_tile_pre_impl(FP const&, char*, int, int, long) {}
+
+// tile CTAs: entry hook with the fusion op's shared storage (fusion op exposes a static tile_entry(op, fusion_smem, tile_idx))
+template <class FP, class FS>
+CUTLASS_DEVICE auto bsvd_tile_entry_impl(FP const& p, FS* fs, int t, int)
+    -> decltype(cute::remove_cvref_t<decltype(bsvd_elem1(p, 0))>::tile_entry(bsvd_elem1(p, 0), static_cast<void*>(nullptr), t), void()) {
+  cute::remove_cvref_t<decltype(bsvd_elem1(p, 0))>::tile_entry(bsvd_elem1(p, 0), reinterpret_cast<void*>(&cute::get<1>(*fs)), t);
+}
+template <class FP, class FS>
+CUTLASS_DEVICE void bsvd_tile_entry_impl(FP const&, FS*, int, long) {}
+
+// tile CTAs: idle warps (sched after its loop, epilogue-load when unused) help the fusion op's epilogue
+// (fusion op exposes a static tile_helper(op, fusion_smem, tile_n, helper_warp))
+template <class FP, class FS>
+CUTLASS_DEVICE auto bsvd_tile_helper_impl(FP const& p, FS* fs, int tn, int hw, int)
+    -> decltype(cute::remove_cvref_t<decltype(bsvd_elem1(p, 0))>::tile_helper(bsvd_elem1(p, 0), static_cast<void*>(nullptr), tn, hw), void()) {
+  cute::remove_cvref_t<decltype(bsvd_elem1(p, 0))>::tile_helper(bsvd_elem1(p, 0), reinterpret_cast<void*>(&cute::get<1>(*fs)), tn, hw);
+}
+template <class FP, class FS>
+CUTLASS_DEVICE void bsvd_tile_helper_impl(FP const&, FS*, int, int, long) {}
+
+// Cluster mode (fusion op exposes cl_S > 0): the grid is cl_C clusters of cl_S CTAs whose first
+// cl_T CTAs are GEMM tiles and the rest side CTAs, plus side-only clusters up to cl_grid CTAs.
+template <class FP>
+CUTLASS_HOST_DEVICE auto bsvd_cl_S_impl(FP const& p, int) -> decltype(int(p.op_1.cl_S)) { return p.op_1.cl_S; }
+template <class FP>
+CUTLASS_HOST_DEVICE int bsvd_cl_S_impl(FP const&, long) { return 0; }
+template <class FP>
+CUTLASS_HOST_DEVICE auto bsvd_cl_T_impl(FP const& p, int) -> decltype(int(p.op_1.cl_T)) { return p.op_1.cl_T; }
+template <class FP>
+CUTLASS_HOST_DEVICE int bsvd_cl_T_impl(FP const&, long) { return 0; }
+template <class FP>
+CUTLASS_HOST_DEVICE auto bsvd_cl_C_impl(FP const& p, int) -> decltype(int(p.op_1.cl_C)) { return p.op_1.cl_C; }
+template <class FP>
+CUTLASS_HOST_DEVICE int bsvd_cl_C_impl(FP const&, long) { return 0; }
+template <class FP>
+CUTLASS_HOST_DEVICE auto bsvd_cl_F_impl(FP const& p, int) -> decltype(int(p.op_1.cl_F)) { return p.op_1.cl_F; }
+template <class FP>
+CUTLASS_HOST_DEVICE int bsvd_cl_F_impl(FP const&, long) { return 0; }
+template <class FP>
+CUTLASS_HOST_DEVICE auto bsvd_cl_grid_impl(FP const& p, int) -> decltype(int(p.op_1.cl_grid)) { return p.op_1.cl_grid; }
+template <class FP>
+CUTLASS_HOST_DEVICE int bsvd_cl_grid_impl(FP const&, long) { return 0; }
+template <class FP, class FS>
+CUTLASS_DEVICE auto bsvd_cl_side_impl(FP const& p, char* smem, FS* fs, int c, int r, int)
