+template <class FP, class FS>
+CUTLASS_DEVICE void bsvd_cl_tile_impl(FP const&, FS*, long) {}
+// static scheduler: pin the CTA's linear tile index (cluster mode)
+template <class Sch>
+CUTLASS_DEVICE auto bsvd_sched_set_impl(Sch& s, uint64_t idx, uint64_t total, int) -> decltype(s.bsvd_set_linear(idx, total), void()) {
+  s.bsvd_set_linear(idx, total);
+}
+template <class Sch>
+CUTLASS_DEVICE void bsvd_sched_set_impl(Sch&, uint64_t, uint64_t, long) {}
+
+// cluster mode: tile coordinates without the hardware cluster offset (static scheduler's 2-arg form)
+template <class Sch, class WTI>
+CUTLASS_DEVICE auto bsvd_cta_coord_impl(Sch& s, WTI const& w, dim3 bid, int) -> decltype(s.work_tile_to_cta_coord(w, bid)) {
+  return s.work_tile_to_cta_coord(w, bid);
+}
+template <class Sch, class WTI>
+CUTLASS_DEVICE auto bsvd_cta_coord_impl(Sch& s, WTI const& w, dim3, long) -> decltype(s.work_tile_to_cta_coord(w)) {
+  return s.work_tile_to_cta_coord(w);
+}
